def read_text_file(file_path: Path) -> str:
    """Read a source .txt file without modifying it."""
    for encoding in ("utf-8", "utf-8-sig", "cp1252", "latin-1"):
        try:
            return file_path.read_text(encoding=encoding)
        except UnicodeDecodeError:
            continue

    raise UnicodeError(
        f"Could not decode source text with common encodings:\n{file_path}"
    )


def parse_source_filename(file_path: Path) -> tuple[str, str]:
    """
    Parse names such as:
        2026-06-01 — Doen.txt
        2026-08-28 - With Rán.txt

    Returns:
        entry_date, entry_title

    When a valid leading YYYY-MM-DD is absent, Date modified is used
    as a fallback and the full filename stem remains the title.
    """
    stem = file_path.stem.strip()

    match = re.match(
        r"^(?P<date>\d{4}-\d{2}-\d{2})"
        r"\s*(?:—|–|-)\s*"
        r"(?P<title>.+?)\s*$",
        stem,
    )

    if match:
        return match.group("date"), match.group("title").strip()

    fallback_date = datetime.fromtimestamp(
        file_path.stat().st_mtime
    ).strftime("%Y-%m-%d")

    return fallback_date, stem


def make_record_slug(text: str) -> str:
    """
    Convert a source title into an ASCII, filename-safe identifier.

    Examples:
        Doen -> DOEN
        With Rán -> WITH-RAN
        Freyja & Rán -> FREYJA-RAN
        Evening Notes #2 -> EVENING-NOTES-2
    """
    normalized = unicodedata.normalize("NFKD", text)

    normalized = "".join(
        character
        for character in normalized
        if not unicodedata.combining(character)
    )

    normalized = normalized.upper()
    normalized = re.sub(r"[^A-Z0-9]+", "-", normalized)

    return normalized.strip("-") or "UNTITLED"


def safe_folder_name(text: str) -> str:
    """Make a Windows-safe subfolder name."""
    invalid_characters = r'<>:"/\|?*'

    cleaned = text.strip()

    for character in invalid_characters:
        cleaned = cleaned.replace(character, "-")

    cleaned = re.sub(r"\s+", " ", cleaned)
    cleaned = cleaned.strip(" .")

    return cleaned or "Uncategorized"


def infer_record_type(division_name: str) -> str:
    """Assign a reasonable editable record type from the source division."""
    mapping = {
        "Skaði": "Entity-Focused Record",
        "Body": "Somatic Record",
        "David Advice": "Correspondence Record",
        "Freyja & Rán": "Entity-Focused Record",
        "Lilith": "Entity-Focused Record",
    }

    return mapping.get(division_name, "Journal Record")


# -------------------------------------------------------------------
# LATEX-SAFE TEXT RENDERING
# -------------------------------------------------------------------

def latex_escape(text: str) -> str:
    """
    Escape LaTeX syntax characters while keeping ordinary Unicode source text.

    This preserves characters such as ð, þ, æ, ö, á, í, and em dashes.
    """
    replacements = {
        "\\": r"\textbackslash{}",
        "&": r"\&",
        "%": r"\%",
        "$": r"\$",
        "#": r"\#",
        "_": r"\_",
        "{": r"\{",
        "}": r"\}",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }

    return "".join(
        replacements.get(character, character)
        for character in text
    )


def render_source_entry(text: str) -> str:
    """
    Convert a journal .txt file into LaTeX paragraphs.

    One or more blank lines form paragraph boundaries.
    Soft line breaks inside source paragraphs are joined with spaces.
    """
    normalized = text.replace("\r\n", "\n").replace("\r", "\n")
    raw_paragraphs = re.split(r"\n\s*\n+", normalized)

    latex_paragraphs = []

    for paragraph in raw_paragraphs:
        clean_lines = [
            line.strip()
            for line in paragraph.split("\n")
            if line.strip()
        ]

        if clean_lines:
            latex_paragraphs.append(
                latex_escape(" ".join(clean_lines))
            )

    if not latex_paragraphs:
        return r"\noindent\textit{No readable source text was found.}"

    return "\n\n".join(latex_paragraphs)


